[Unit]
Description=Nanoleaf Hue direct Sync+ receiver
Wants=network-online.target avahi-daemon.service
After=network-online.target avahi-daemon.service

[Service]
User=nanoleaf-hue
Group=nanoleaf-hue
StateDirectory=nanoleaf-hue-virtual
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/nanoleaf-hue/venv/bin/python /opt/nanoleaf-hue/nanoleaf_probe.py --bind-ipv6 :: --ssdp --state /var/lib/nanoleaf-hue-virtual/state.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
